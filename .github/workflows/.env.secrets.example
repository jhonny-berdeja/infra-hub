# GitHub Actions repository secrets used by the workflows in this folder.
#
# This file is a reference, not a real env file: GitHub Actions secrets are
# configured in the repo/org settings (Settings > Secrets and variables >
# Actions), not loaded from disk. Copy the names below when creating them.

# Tailscale OAuth client used to join the tailnet and reach the microk8s
# API server. Used by: deploy-pcbox-api.yml, deploy-ticket-hub.yml,
# deploy-ticket-hub-api.yml, deploy-auth-api.yml, deploy-iam.yml, deploy-iam-api.yml
TS_OAUTH_CLIENT_ID=
TS_OAUTH_SECRET=

# kubeconfig (base64 or raw content, see save-kubeconfig.sh) for the pcbox
# microk8s cluster. Used by: deploy-pcbox-api.yml, deploy-ticket-hub.yml,
# deploy-ticket-hub-api.yml, deploy-auth-api.yml, deploy-iam.yml, deploy-iam-api.yml
KUBECONFIG_PCBOX=

# Docker Hub username substituted into the image reference in the deployment
# manifests. Used by: deploy-pcbox-api.yml, deploy-ticket-hub.yml,
# deploy-ticket-hub-api.yml, deploy-auth-api.yml, deploy-iam.yml, deploy-iam-api.yml
DOCKERHUB_USERNAME=

# SSH connection details substituted into the pcbox-api manifest placeholders.
# Used by: deploy-pcbox-api.yml
SSH_HOST=
SSH_USER=
